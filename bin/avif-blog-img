#!/bin/zsh -e

# creates AVIF images from list of input files, given a "base" string initial argument
function usage() {
  cat<<EOF
Usage: $1 <basename eg: '2025-europe'>  <image input file1> <image input file2> ..

You can also add first args like
  -oldest         sort input files by capture time (DateTimeOriginal; else FS birth time) oldest first
  -keepgps        preserve GPS data (default: stripped for privacy)
  -featured FILE  convert FILE to .webp instead of .avif (for og:image / iOS sharing)
  -v              verbose show the CLI magick command for each

  -mirror DIR     mirror each input's own path under DIR instead of numbering.
                  No <basename> argument is used in this mode.
                    (cd img && $1 -mirror thumbs wed/DSC_0018.JPG)
                      => thumbs/wed/DSC_0018.avif
                  Keeps the original filename, so a derivative can always be traced
                  back to the photographer who shot it.
  -width N        resize to exactly N pixels wide.  Without this, inputs are halved
                  repeatedly until under ${MAX_WIDTH}px, which is kinder to quality but
                  overshoots small targets (an 8256px frame lands on 516px, not 1000).


Script will print the invocation for this at the end:
  bin/post-from-imagery



TYPICAL USAGE:

$1 -oldest -featured heic3  2026-my-filenames-slug  jpg1 jpg2 heic1 heic2 heic3

EOF
}


MAX_WIDTH=2500
ARGS=(-auto-orient)
OLDEST=0
KEEPGPS=0
FEATURED=
VERBOSE=
MIRROR=
EXACT_WIDTH=

[[ -n $1 ]] || set -- '-usage' "$@"
set -u
while [[ $1 == -* ]]; do
  case $1 in
    -oldest)   OLDEST=1 ;;
    -keepgps)  KEEPGPS=1 ;;
    -v)        VERBOSE=1 ;;
    -featured) FEATURED=$2; shift ;;
    -mirror)   MIRROR=${2%/}; shift ;;
    -width)    EXACT_WIDTH=$2; shift ;;
    *) usage $0; exit 1 ;;
  esac
  shift
done

# -mirror names outputs after their inputs, so there is no basename to consume
if [[ -z $MIRROR ]]; then
  BASE=$1
  shift
else
  BASE=
fi

if (( OLDEST )); then
  local -a time_tagged
  for f in "$@"; do
    # prefer embedded capture time; fall back to filesystem birth time
    local t=$(exiftool -s3 -DateTimeOriginal "$f" 2>/dev/null | tr -dc '0-9')
    [[ -z $t ]] && t=$(stat -f '%SB' -t '%Y%m%d%H%M%S' -- "$f")
    time_tagged+=("$t $f")
  done
  time_tagged=("${(@n)time_tagged}")

  # *REWRITE* CLI args — sorted oldest first
  set -- "${time_tagged[@]#* }"
fi

if [[ -n $BASE && -e "$BASE" ]]; then
  echo "flipped args?"
  return
fi

while (( $# )); do
  IMG="$1"
  shift
  if [ ! -e "$IMG" ]; then break; fi

  local EXT=avif
  [[ -n $FEATURED && $IMG == $FEATURED ]] && EXT=webp

  if [[ -n $MIRROR ]]; then
    # keep the input's own name and path -- provenance survives the conversion
    local SUBDIR=${IMG:h}
    [[ $SUBDIR == '.' ]] && SUBDIR=
    OUT=${MIRROR}${SUBDIR:+/$SUBDIR}/${IMG:t:r}.$EXT
    mkdir -p ${OUT:h}
    # batches here run to the hundreds, so make re-runs resumable
    if [[ -e $OUT ]]; then
      echo "$OUT\tskipped (exists)"
      continue
    fi
  else
    for n in $(seq -w 0 99); do
      OUT=${BASE}-$n.$EXT
      if [ ! -e $OUT ]; then break; fi
    done
  fi

  WIDTH=$(identify -format "%w" "$IMG")
  if [[ -n $EXACT_WIDTH ]]; then
    local RESIZED_WIDTH=$EXACT_WIDTH
  else
    # resize/shrink input by multiples of 2, until the output width is <= $MAX_WIDTH
    DIVISOR=1
    while true; do
      local RESIZED_WIDTH=$(( WIDTH * 2 / (2**DIVISOR) ))
      if [ $RESIZED_WIDTH -le $MAX_WIDTH ]; then
        break
      fi
      let "DIVISOR=$DIVISOR+1"
    done
  fi
  # Make sure it's even
  RESIZED_WIDTH=$(( RESIZED_WIDTH - RESIZED_WIDTH % 2 ))
  echo "$OUT\t${WIDTH}w => $RESIZED_WIDTH"

  ARGS2=()
  if [[ $EXT == avif ]]; then
    # avif:effort => higher === slower & higher quality
    ARGS2+=(-define avif:effort=6)
  fi

  (
    [ $VERBOSE ] && set -x
    magick "$IMG" $ARGS -resize $RESIZED_WIDTH $ARGS2 -quality 90 $OUT
  )

  # always drop Orientation (baked in by -auto-orient); strip GPS unless -keepgps
  local exif_args=(-Orientation= -overwrite_original -quiet)
  (( KEEPGPS )) || exif_args+=(-gps:all=)
  exiftool $exif_args "$OUT"
done

if [[ -n $MIRROR ]]; then
  echo "\nmirrored into ${MIRROR}/ -- filenames match their originals"
else
  echo "\n/../bin/post-from-imagery ${BASE}-"
fi
