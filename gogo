#!/bin/zsh -eu
mydir=${0:a:h}

# Does some minor manipulations to get HuGo to work nicely w/ the desired repo directory layout.
# Used in local dev on a mac; and in GitHub Actions

cd $mydir

# Delete only the index.md files this script generated.  Nothing else is touched --
# the .html sources were copied, never moved, so an interrupted run cannot leave the
# repo half-renamed.  (`find -name index.md` is safe: no *tracked* index.md exists,
# and every real .md here is named otherwise -- info.md, README.md, _index.md.)
function restore-source-files() {
  ( set +e; mv data/comments . && rmdir data )
  for MD in $(find . -mindepth 2 -type f -name 'index.md' |cut -f2- -d/ |grep -Ev ^public/); do
    rm $MD
  done
}

UNAMEY=$(uname)

if [ "$UNAMEY" = Darwin ]; then
  # in dev mode
  trap restore-source-files EXIT
else
  # GitHub Actions
  # Setup theme
  set -x
  pwd
  wget -q https://github.com/traceypooh/hugo-future-imperfect-slim/archive/refs/heads/master.zip
  unzip -q master.zip
  mv hugo-future-imperfect-slim-master theme
  set +x
fi


# sigh :p
mkdir -p data
mv comments data

NPAGES=0
NPOSTS=0

# Every .html content source that Hugo should build from.
function content-sources() {
  find . -mindepth 2 -type f -name 'index.html' |cut -f2- -d/ |grep -Ev ^public/
}

# Turn ONE .html source into the .md Hugo actually builds from.
#
# Shared by the startup pass and by watch mode deliberately: if the two ever handled
# aliases or `type:` differently, the page you previewed would not be the page that
# ships, which is the worst kind of dev-server bug.
# Returns non-zero if the source is unusable; the caller decides whether that is
# fatal (startup: yes) or just worth reporting (watch: no).
function make-md() {
  local HTM=$1
  if ( ! grep -qE '^---' $HTM ); then
    # No front matter, so not Hugo content.  These are the real passthrough HTML
    # pages (lacer, resume, amy, gears, alc/*) -- leave them exactly where they are.
    return 0
  fi

  # Hugo will not parse a .html content file as markdown -- there is no config for
  # it (tried: remapping the `html` suffix onto text/markdown, and taking it off
  # text/html entirely; both still pass through).  So hand it a .md copy instead.
  #
  # The .html does NOT need moving out of the way: with both present in one bundle
  # directory, Hugo picks index.md as the page and treats index.html as a plain
  # bundle resource, which never reaches public/.  Verified by diffing a full build
  # both ways -- every post and page came out byte-identical.
  #
  # Copying rather than moving matters: the 24 index.html files that carry NO front
  # matter (lacer, resume, amy, gears, alc/*) are real passthrough HTML that
  # Hugo renders into the theme layout, and they must stay exactly where they are.
  # That is also why this cannot be an `ignoreFiles` rule -- the distinction is front
  # matter, not path.
  local MD=$(echo $HTM |perl -pe 's/\.html$/.md/')
  cp $HTM $MD

  local ALIASED=
  local DATE YYYY MM DD TTL ALIAS1 ALIAS2 ALIASES MISSING

  # NB: the counters below return the value BEFORE incrementing, so `((NPAGES++))`
  # exits 1 the first time.  That is why `set +e` has to come first.
  set +e
  if ( grep -qE '^type: page$' $MD ); then
    ((NPAGES++))
  else
    ((NPOSTS++))

    # add aliases to every post like this
    # (or ensure a page w/ additional aliases have them)
    #   /YYYY/MM/DD/<slug>/
    #   /YYYY/MM/<slug>/
    # those will then redirect back to /YYYY-MM-<slug> (or rare /YYYY-MM-DD-<slug>)
    DATE=$(grep -Eo '^date: [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' $MD |cut -f2 -d ' ')
    if [ "$DATE" = "" ]; then
      echo "$HTM has no 'date:'"
      set -e   # restore before bailing, or the caller inherits `set +e`
      return 1
    fi

    if ( grep -qE '^aliases:' $MD ); then
      ALIASED=1
    fi

    if ( grep -qE '^type: post$' $MD ); then
      if [[ $MD == 20* ]]; then
        # post with filename starting with '20'(YY-MM-..)
        # TTL is dirname with lead YYYY-MM- removed
        YYYY=$(echo $DATE |cut -d- -f1)
          MM=$(echo $DATE |cut -d- -f2)
          DD=$(echo $DATE |cut -d- -f3)
        TTL=$(echo $MD |rev |cut -f2- -d/ |rev |cut -f3- -d-)
        ALIAS1="/$YYYY/$MM/$DD/$TTL/"
        ALIAS2="/$YYYY/$MM/$TTL/"
        ALIASES="aliases: ['$ALIAS1', '$ALIAS2']"

        if [ $ALIASED ]; then
          # check the front matter for the 2 standard aliases we always want present
          MISSING=
          tail +2 $MD |fgrep -B100 -m1 -- --- | grep -q "$ALIAS1" || MISSING=1
          tail +2 $MD |fgrep -B100 -m1 -- --- | grep -q "$ALIAS2" || MISSING=1
          if [ $MISSING ]; then
            echo "ERROR: $HTM has manual aliases but is missing standard date-path aliases."
            echo "  When adding a manual alias, also keep the standard ones:"
            echo "  aliases:"
            echo "    - $ALIAS1"
            echo "    - $ALIAS2"
            echo "    - /your-manual-alias/"
          fi
        else
          perl -i -pe 's#^(date: .*)#$1\n'$ALIASES'#' $MD
        fi
      fi
    else
      echo "Adding 'type: post' to $MD"
      perl -i -pe 's#^(date: .*)#$1\ntype: post#' $MD
    fi
  fi
  set -e
}

for HTM in $(content-sources); do
  make-md $HTM || exit 1
done

echo Number Posts: $NPOSTS
echo Number Pages: $NPAGES

ARGS=()
if [ "$UNAMEY" = Darwin ]; then
  ARGS+=(--buildDrafts)
fi
( set -eux; hugo $ARGS )

# Hugo skips .htm files (no frontmatter); copy them manually
find alc -type f -name '*.htm' -o -name '*.html' | while IFS= read -r f; do
  mkdir -p "public/${f%/*}"
  if [ -e "public/$f" ]; then continue; fi
  cp "$f" "public/$f"
done

# cheap check if GitHub Actions or dev mode on mac
if [ "$UNAMEY" = Darwin ]; then
  restore-source-files

  ( set -eux; caddy file-server -r public --listen :1313 )
fi
