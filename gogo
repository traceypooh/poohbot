#!/bin/zsh -eu
mydir=${0:a:h}

# Does some minor manipulations to get HuGo to work nicely w/ the desired repo directory layout.
# Used in local dev on a mac; and in GitHub Actions

cd $mydir

# -w / --watch : run Hugo's own dev server with live reload instead of building once
# and handing the result to caddy.  Hugo only ever sees the generated .md, so the
# watcher below keeps that in step with the .html you are actually editing.
WATCH=
if [[ ${1:-} == (-w|--watch) ]]; then
  WATCH=1
  shift
fi
POLL=3  # seconds between checks; a stat of ~165 files is cheap but not free

# Delete only the index.md files this script generated.  Nothing else is touched --
# the .html sources were copied, never moved, so an interrupted run cannot leave the
# repo half-renamed.  (`find -name index.md` is safe: no *tracked* index.md exists,
# and every real .md here is named otherwise -- info.md, README.md, _index.md.)
function restore-source-files() {
  find . -mindepth 2 -type f -name index.md -delete
}

UNAMEY=$(uname)

if [ "$UNAMEY" = Darwin ]; then
  # in dev mode
  trap restore-source-files EXIT
else
  # GitHub Actions
  # Setup theme
  set -x
  pwd
  wget -q https://github.com/traceypooh/hugo-future-imperfect-slim/archive/refs/heads/master.zip
  unzip -q master.zip
  mv hugo-future-imperfect-slim-master theme
  set +x
fi


NPAGES=0
NPOSTS=0

# Every .html content source that Hugo should build from.
function content-sources() {
  find . -name public -prune -o -name .git -prune -o -name index.html -print |cut -b3-
}

# Turn ONE .html source into the .md Hugo actually builds from.
#
# Shared by the startup pass and by watch mode deliberately: if the two ever handled
# aliases or `type:` differently, the page you previewed would not be the page that
# ships, which is the worst kind of dev-server bug.
# Returns non-zero if the source is unusable; the caller decides whether that is
# fatal (startup: yes) or just worth reporting (watch: no).
function make-md() {
  local HTM=$1
  if ( ! grep -qE '^---' $HTM ); then
    # No front matter, so not Hugo content.  These are the real passthrough HTML
    # pages (lacer, resume, amy, gears, alc/*) -- leave them exactly where they are.
    return 0
  fi

  # Hugo will not parse a .html content file as markdown -- there is no config for
  # it (tried: remapping the `html` suffix onto text/markdown, and taking it off
  # text/html entirely; both still pass through).  So hand it a .md copy instead.
  #
  # The .html does NOT need moving out of the way: with both present in one bundle
  # directory, Hugo picks index.md as the page and treats index.html as a plain
  # bundle resource, which never reaches public/.  Verified by diffing a full build
  # both ways -- every post and page came out byte-identical.
  #
  # Copying rather than moving matters: the 24 index.html files that carry NO front
  # matter (lacer, resume, amy, gears, alc/*) are real passthrough HTML that
  # Hugo renders into the theme layout, and they must stay exactly where they are.
  # That is also why this cannot be an `ignoreFiles` rule -- the distinction is front
  # matter, not path.
  # zsh suffix replacement, not `echo | perl`: this runs once per post, and in watch
  # mode once per post per poll.  Spawning perl 188 times costs 0.8s against 0.04s
  # for the shell doing it in-process -- per poll, that was 27% of a core burnt on
  # renaming strings.
  local MD=${HTM%.html}.md
  cp $HTM $MD

  local ALIASED=
  local DATE YYYY MM DD TTL ALIAS1 ALIAS2 ALIASES MISSING

  # NB: the counters below return the value BEFORE incrementing, so `((NPAGES++))`
  # exits 1 the first time.  That is why `set +e` has to come first.
  set +e
  if ( grep -qE '^type: page$' $MD ); then
    ((NPAGES++))
  else
    ((NPOSTS++))

    # add aliases to every post like this
    # (or ensure a page w/ additional aliases have them)
    #   /YYYY/MM/DD/<slug>/
    #   /YYYY/MM/<slug>/
    # those will then redirect back to /YYYY-MM-<slug> (or rare /YYYY-MM-DD-<slug>)
    DATE=$(grep -Eo '^date: [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' $MD |cut -f2 -d ' ')
    if [ "$DATE" = "" ]; then
      echo "$HTM has no 'date:'"
      set -e   # restore before bailing, or the caller inherits `set +e`
      return 1
    fi

    if ( grep -qE '^aliases:' $MD ); then
      ALIASED=1
    fi

    if ( grep -qE '^type: post$' $MD ); then
      if [[ $MD == 20* ]]; then
        # post with filename starting with '20'(YY-MM-..)
        # TTL is dirname with lead YYYY-MM- removed
        YYYY=$(echo $DATE |cut -d- -f1)
          MM=$(echo $DATE |cut -d- -f2)
          DD=$(echo $DATE |cut -d- -f3)
        TTL=$(echo $MD |rev |cut -f2- -d/ |rev |cut -f3- -d-)
        ALIAS1="/$YYYY/$MM/$DD/$TTL/"
        ALIAS2="/$YYYY/$MM/$TTL/"
        ALIASES="aliases: ['$ALIAS1', '$ALIAS2']"

        if [ $ALIASED ]; then
          # check the front matter for the 2 standard aliases we always want present
          MISSING=
          tail +2 $MD |fgrep -B100 -m1 -- --- | grep -q "$ALIAS1" || MISSING=1
          tail +2 $MD |fgrep -B100 -m1 -- --- | grep -q "$ALIAS2" || MISSING=1
          if [ $MISSING ]; then
            echo "ERROR: $HTM has manual aliases but is missing standard date-path aliases."
            echo "  When adding a manual alias, also keep the standard ones:"
            echo "  aliases:"
            echo "    - $ALIAS1"
            echo "    - $ALIAS2"
            echo "    - /your-manual-alias/"
          fi
        else
          perl -i -pe 's#^(date: .*)#$1\n'$ALIASES'#' $MD
        fi
      fi
    else
      echo "Adding 'type: post' to $MD"
      perl -i -pe 's#^(date: .*)#$1\ntype: post#' $MD
    fi
  fi
  set -e
}

for HTM in $(content-sources); do
  make-md $HTM || exit 1
done

echo Number Posts: $NPOSTS
echo Number Pages: $NPAGES

ARGS=()
if [ "$UNAMEY" = Darwin ]; then
  ARGS+=(--buildDrafts)
fi

# Hugo skips .htm files (no front matter); copy them manually.
#
# Scoped to alc/ ON PURPOSE.  ciclo/, old/ and test/ publish fine as directories --
# their index.html pages are live -- but the 15 loose .htm files sitting beside them
# are not copied, 404 today, and nothing links to them.  Widening this would silently
# put those back online.  If any should go live, add that directory here rather than
# dropping the scope.
#
# The parenthesis matters: without it, `-type f -name '*.htm' -o -name '*.html'`
# parses as (type f AND *.htm) OR (*.html), so the second branch loses the file test.
function copy-skipped-htm() {
  find alc -type f \( -name '*.htm' -o -name '*.html' \) | while IFS= read -r f; do
    mkdir -p "public/${f%/*}"
    if [ -e "public/$f" ]; then continue; fi
    cp "$f" "public/$f"
  done
}

if [ $WATCH ]; then
  # Hugo builds from the copied .md, so editing a .html shows nothing until its
  # .md twin is refreshed.  A hard link looks like the obvious fix and is not: the write
  # lands on the .html path, so Hugo's watcher never gets an event for the .md, and
  # an editor that saves atomically silently severs the link and freezes the page.
  # Polling and re-running make-md works whatever the editor does.
  #
  ( while sleep $POLL; do
      for HTM in $(content-sources); do
        # Regenerate when the twin is missing (a post you just started) or stale (one
        # you just edited).  No `-e` guard needed: zsh's -nt is simply false when
        # either side is absent, which would silently skip a brand new post forever.
        [[ ! -e ${HTM%.html}.md || $HTM -nt ${HTM%.html}.md ]] && { make-md $HTM || true }
      done

      # CSS is the one thing Hugo's server detects but never re-copies: add-on.css is a
      # plain <link href=...>, not an asset-pipeline resource, so it is published once and
      # then left alone.  (.md, js/ and img/ all refresh correctly -- css is the outlier.)
      # So copy it ourselves.  Hugo has already rebuilt and reloaded the browser by the
      # time our poll notices, which would leave the page showing the OLD css until some
      # later edit -- hence the touch, which makes Hugo rebuild once more and reload with
      # the new file in place.
      for CSS in css/*.css(N); do
        if [[ ! -e public/$CSS || $CSS -nt public/$CSS ]]; then
          # `|| continue` is not decoration: this loop starts before hugo server has
          # finished its first build, so public/css/ may not exist yet.  A bare failing
          # cp under `set -e` kills this whole subshell -- silently, leaving you with a
          # watcher that simply never fires again.
          cp $CSS public/$CSS 2>/dev/null || continue
          # Re-touch the SOURCE so Hugo rebuilds once more and the browser reloads
          # against the copy we just made.  Then re-touch the PUBLISHED file so it
          # stays newer than the source -- otherwise this same test fires on every
          # poll and we copy/touch/rebuild forever.
          touch $CSS
          touch public/$CSS
        fi
      done
    done ) &
  WATCH_PID=$!
  # kill the watcher BEFORE the .md files are removed, or it recreates them
  trap "kill $WATCH_PID 2>/dev/null; restore-source-files" EXIT

  # hugo server writes to disk by default (memory is opt-in via --renderToMemory),
  # and it never cleans public/, so these survive its rebuilds -- they live at paths
  # Hugo does not write.
  copy-skipped-htm
  ( set -eux; hugo server $ARGS --disableFastRender )
else
  ( set -eux; hugo $ARGS )
  copy-skipped-htm

  # cheap check if GitHub Actions or dev mode on mac
  if [ "$UNAMEY" = Darwin ]; then
    restore-source-files

    ( set -eux; caddy file-server -r public --listen :1313 )
  fi
fi
